\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{myfont-setting}[2026/09/23 Preferred fonts with portable fallbacks]
\RequirePackage{luatexja}
\RequirePackage{luatexja-fontspec}

% Prefer the fonts specified in the supplied latest edition.
% Fall back to TeX Live fonts when those local fonts are unavailable.
\IfFontExistsTF{Futura ND Book}
  {\setmainfont{Futura ND Book}}
  {\setmainfont{Latin Modern Roman}}

\IfFontExistsTF{Helvetica Neue}
  {\setsansfont{Helvetica Neue}[
    BoldFont={Helvetica Neue Bold},
    ItalicFont={Helvetica Neue Italic},
    BoldItalicFont={Helvetica Neue Bold Italic}]}
  {\setsansfont{Latin Modern Sans}}

\IfFontExistsTF{Inconsolata}
  {\setmonofont{Inconsolata}}
  {\setmonofont{Latin Modern Mono}}

\IfFontExistsTF{Hiragino Mincho ProN}
  {\setmainjfont{Hiragino Mincho ProN}}
  {\setmainjfont[BoldFont=HaranoAjiGothic-Bold.otf]{HaranoAjiMincho-Regular.otf}}
\IfFontExistsTF{Hiragino Sans}
  {\setsansjfont{Hiragino Sans}}
  {\setsansjfont[BoldFont=HaranoAjiGothic-Bold.otf]{HaranoAjiGothic-Medium.otf}}

\linespread{1.05}
